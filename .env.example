# ===============================================================
# INGEDUCA CORP - AulaPredict Configuración de IA
# ===============================================================
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_de_google_ai_studio_aqui

# Modelo recomendado de Gemini (rápido, multimodal y gratuito)
GEMINI_MODEL=gemini-2.0-flash

# ===============================================================
# INGEDUCA CORP - Base de Datos y Seguridad (SQLAlchemy & JWT)
# ===============================================================
# Por defecto SQLite local (cero configuración requerida)
DATABASE_URL=sqlite:///./ingeduca.db
# Si deseas migrar a PostgreSQL en producción:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/ingeduca_db

# Clave secreta para firma criptográfica de tokens JWT
JWT_SECRET_KEY=INGEEDUCA_CAMPUS_VIRTUAL_SUPER_SECRET_KEY_PROD_2026_THESIS_SECURITY_KEY_32BYTES

